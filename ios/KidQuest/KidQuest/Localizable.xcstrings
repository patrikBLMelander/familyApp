    "Jag tycker om att smyga runt i skuggan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich schleiche gern im Schatten herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I like sneaking around in the shade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me gusta andar a escondidas por la sombra."
