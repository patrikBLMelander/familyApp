    "Sysslor, avklaranden, XP, djur och plånbokshistorik försvinner med medlemmen. Det går inte att ångra." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben, Erledigungen, XP, Tiere und der Geldbörsen-Verlauf werden mit dem Mitglied gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chores, completions, XP, pets and wallet history go with the member. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas, lo completado, los XP, las mascotas y el historial del monedero se eliminan con el miembro. No se puede deshacer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sysslor, avklaranden, XP, djur och plånbokshistorik försvinner med medlemmen. Det går inte att ångra."
          }
        }
      }
    },
