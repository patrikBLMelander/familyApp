    "Något annat använder kanske kameran just nu. Försök igen, eller skriv in koden för hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht nutzt gerade etwas anderes die Kamera. Versuche es noch einmal oder gib den Code von Hand ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something else may be using the camera right now. Try again, or type the code in by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que otra cosa esté usando la cámara ahora mismo. Inténtalo de nuevo o escribe el código a mano."
