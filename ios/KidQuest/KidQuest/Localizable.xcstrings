    "Den här enheten har ingen kamera att skanna med. Skriv in koden för hand i stället — den står under QR-koden på förälderns skärm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat keine Kamera zum Scannen. Gib den Code stattdessen von Hand ein – er steht unter dem QR-Code auf dem Bildschirm der Eltern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has no camera to scan with. Type the code in by hand instead — it's under the QR code on the parent's screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene cámara para escanear. Escribe el código a mano: está debajo del código QR en la pantalla del padre o la madre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten har ingen kamera att skanna med. Skriv in koden för hand i stället — den står under QR-koden på förälderns skärm."
          }
        }
      }
    },
