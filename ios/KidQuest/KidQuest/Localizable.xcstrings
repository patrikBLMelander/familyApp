    "\"%@\" tas bort för %@, tillsammans med historiken över när den blivit gjord. Det går inte att ångra." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wird für %2$@ gelöscht, zusammen mit dem Verlauf, wann sie erledigt wurde. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" will be removed for %2$@, along with the history of when it was done. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará \"%1$@\" para %2$@, junto con el historial de cuándo se hizo. No se puede deshacer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" tas bort för %@, tillsammans med historiken över när den blivit gjord. Det går inte att ångra."
          }
        }
      }
    },
