    "Föräldern kopplar sin telefon med QR-koden på deras kort. E-post och lösenord kan sättas i webbappen om de behöver logga in på en ny enhet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Elternteil verbindet sein Handy über den QR-Code auf seiner Karte. E-Mail und Passwort können in der Web-App gesetzt werden, falls die Anmeldung auf einem neuen Gerät nötig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The parent links their phone with the QR code on their card. Email and password can be set in the web app if they need to sign in on a new device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El padre o la madre vincula su teléfono con el código QR de su tarjeta. El correo y la contraseña se pueden poner en la app web si necesita iniciar sesión en otro dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föräldern kopplar sin telefon med QR-koden på deras kort. E-post och lösenord kan sättas i webbappen om de behöver logga in på en ny enhet."
          }
        }
      }
    },
