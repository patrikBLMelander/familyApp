    "%@ får beloppet för den nivå hen nått den 1:a. Nivån nollställs varje månad, precis som djuret." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bekommt am 1. den Betrag für das erreichte Level. Das Level startet jeden Monat neu, genau wie das Tier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gets the amount for the level they've reached on the 1st. The level resets every month, just like the pet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recibe el importe del nivel que haya alcanzado el día 1. El nivel se reinicia cada mes, igual que la mascota."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ får beloppet för den nivå hen nått den 1:a. Nivån nollställs varje månad, precis som djuret."
          }
        }
      }
    },
