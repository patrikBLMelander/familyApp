    "Det här tar bort hela familjen och allt som hör till den: alla barn och vuxna, sysslor, XP, djur, plånböcker och sparmål. Även för de andra i familjen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die ganze Familie mit allem gelöscht: alle Kinder und Erwachsenen, Aufgaben, XP, Tiere, Geldbörsen und Sparziele. Auch für alle anderen in der Familie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes the whole family and everything in it: all kids and adults, chores, XP, pets, wallets and savings goals. For everyone else in the family too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina toda la familia y todo lo que contiene: todos los niños y adultos, tareas, XP, mascotas, monederos y metas de ahorro. También para el resto de la familia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här tar bort hela familjen och allt som hör till den: alla barn och vuxna, sysslor, XP, djur, plånböcker och sparmål. Även för de andra i familjen."
          }
        }
      }
    },
