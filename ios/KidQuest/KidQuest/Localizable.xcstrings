    "Förnya för att lägga till sysslor och familjemedlemmar igen. Barnens sysslor och djur fungerar som vanligt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängere, um wieder Aufgaben und Familienmitglieder hinzuzufügen. Die Aufgaben und Tiere der Kinder funktionieren ganz normal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renew to add chores and family members again. The kids' chores and pets keep working as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renueva para volver a añadir tareas y miembros de la familia. Las tareas y mascotas de los niños siguen funcionando con normalidad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnya för att lägga till sysslor och familjemedlemmar igen. Barnens sysslor och djur fungerar som vanligt."
          }
        }
      }
    },
    "Förnyas automatiskt tills du avslutar. Du avslutar när du vill i App Store och behåller tiden du redan betalat för." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, bis du kündigst. Du kannst jederzeit im App Store kündigen und behältst die bereits bezahlte Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically until you cancel. Cancel any time in the App Store and keep the time you've already paid for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente hasta que canceles. Puedes cancelar cuando quieras en la App Store y conservas el tiempo que ya has pagado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas automatiskt tills du avslutar. Du avslutar när du vill i App Store och behåller tiden du redan betalat för."
          }
        }
      }
    },
