    "Om adressen finns hos oss har vi skickat en länk dit. Den gäller i en timme. Titta i skräpposten om den inte dyker upp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls wir die Adresse kennen, haben wir einen Link dorthin geschickt. Er gilt eine Stunde. Schau im Spam-Ordner nach, falls er nicht ankommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If we have that address, we've sent a link to it. It's valid for one hour. Check your spam folder if it doesn't show up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tenemos esa dirección, te hemos enviado un enlace. Es válido durante una hora. Mira en la carpeta de spam si no aparece."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om adressen finns hos oss har vi skickat en länk dit. Den gäller i en timme. Titta i skräpposten om den inte dyker upp."
          }
        }
      }
    },
