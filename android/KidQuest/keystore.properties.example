# Copy to keystore.properties (same directory) and fill in.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties and *.jks are gitignored. Never commit either.
#
# Losing the upload keystore means you can no longer publish updates to an
# existing Play listing, so back it up somewhere durable - a password manager
# or an encrypted archive, not just this machine.
#
# storeFile is resolved relative to android/KidQuest/.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=

# CI can supply the same four values as environment variables instead, which is
# why no file is required:
#
#   KIDQUEST_STORE_FILE
#   KIDQUEST_STORE_PASSWORD
#   KIDQUEST_KEY_ALIAS
#   KIDQUEST_KEY_PASSWORD
