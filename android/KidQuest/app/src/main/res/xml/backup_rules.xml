<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup rules for Android 11 and older. Android 12+ reads
    data_extraction_rules.xml instead, which must be kept in step with this file.

    Everything is backed up except the signed-in session. A device token is a bearer
    key to a family member's account. For children it is the whole login, since they
    have no password. It has no business sitting in a cloud backup, and the value would
    not open on the restored phone anyway: it is encrypted with a key held in this
    device's keystore, which never leaves it.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/kidquest_session.preferences_pb" />
</full-backup-content>
