<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for Android 12+. Keep in step with backup_rules.xml,
    which covers older versions.

    The signed-in session is excluded from both paths. Cloud backup is the one that
    matters: a child's device token is their entire login, and copying it off the phone
    turns "someone read a backup" into "someone is signed in as that child". It is left
    out of device-to-device transfer for the same reason, and because the key that
    could decrypt it stays behind on the old phone regardless.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/kidquest_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/kidquest_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
